# Tollgate — Environment Variables
PORT=8000
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_REGION=ap-northeast-1
TABLE_NAME=Tollgate
# OPENAPI_PATH=/openapi.json # OpenAPI 3.1 仕様スキーマのパスマッピング (未指定または空文字で無効化)
# DOCS_PATH=/docs # Scalar ドキュメント UI のパスマッピング (未指定または空文字で無効化)

# ─────────────────────────────────────────────────────────────────────────────
# リバースプロキシ設定 (JSON 環境変数 または 設定ファイルで指定)
# ─────────────────────────────────────────────────────────────────────────────
# 動的マルチターゲット・ルーティング (JSON 配列文字列)
PROXY_ROUTES=[{"prefix":"/llm","target":"http://llm-gateway:8000","scope":"llm:*","strip_prefix":true},{"prefix":"/mcp","target":"http://mcp-gateway:8000","scope":"mcp:*","strip_prefix":true},{"prefix":"/ai","target":"http://ai-engine:8000","scope":"ai:*","strip_prefix":true}]

# または設定ファイルパスによる指定 (ROUTES_CONFIG_FILE)
# ROUTES_CONFIG_FILE=./routes.json

# 未マッチ時のデフォルトフォールバック先 (未指定時は 404)
# FORWARD_TARGET_URL=http://webapi:8000


